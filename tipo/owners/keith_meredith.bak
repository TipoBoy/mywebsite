<!--//

   if (document.images) {

      // Load images needed [BACK] button.

      back_on  = new Image(); back_on.src  = "../../buttons/back_on.gif";  
      back_off = new Image(); back_off.src = "../../buttons/back.gif";  
   }

   function TurnOn() {

      // Displays image and updates status bar.

      if (document.images) {
         document["back"].src = back_on.src;
         window.status = 'Go back to previous page';
      }
   }

   function TurnOff() {

      // Displays image and clears status bar.

      if (document.images) {
         document["back"].src = back_off.src;
         window.status = '';
      }
   }

//-->

</SCRIPT>

<H3><CENTER><FONT COLOR="#ffff00"><A HREF="mailto:KMere58052@aol.com">Keith Meredith</A></FONT></CENTER></H3>


	Keith has a 1992 K reg 5 door, metallic silver 16v that he has
	owner for 2 years. It's just had a full
	belt change and tune-up and the car is running 
        really sweet. He is currently
	trying to make some cosmetic changes to his car, nothing outrageous
	or over the top. He has just replaced the badges on the car and
	added some Abarth stickers. The car is 
        fairly standard except for up-rated front discs and pads (no ABS).
	It also has wind deflectors on the front windows.
